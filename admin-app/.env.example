# PostgreSQL connection
DATABASE_URL="postgresql://USER@localhost:5432/ob_cn_dev?schema=public"

# NextAuth (admin backend login)
AUTH_SECRET="change-me"

# Persistent storage for community files. Mount this path to durable storage in
# production; files are private and are served only after membership checks.
# COMMUNITY_UPLOAD_DIR=/absolute/path/to/community-uploads

# Email verification codes (登录/注册) — any plain SMTP provider works.
# Use a non-Google provider (Brevo / Mailgun / 阿里云邮件推送 / 腾讯云 SES /
# self-hosted SMTP) so mail delivery works in regions without Google access.
# Leave SMTP_HOST unset in local dev: codes are printed to the server log.
# Optional reusable code for local browser testing only. It is ignored when
# NODE_ENV=production.
# OPENBIBLE_TEST_LOGIN_CODE=070730
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# EMAIL_FROM="OpenBible <no-reply@yourdomain.com>"

# Google Sign-In server audience (OAuth client type: Web application).
# 这个值是三端唯一真相：网页版通过 /api/web/config/auth 读取它，App 端构建时用
# VITE_GOOGLE_WEB_CLIENT_ID 传同一个值，服务端用它校验 ID Token 的 audience。
# 三者必须完全一致，否则登录会被以 401 拒绝。
# 生产环境留空 = 关闭 Google 登录（登录入口自动隐藏），不会回落到下面的演示值。
GOOGLE_WEB_CLIENT_ID="1036636088293-gihlhd5hlur5m8btmrr077efq69v95o0.apps.googleusercontent.com"

# Sign in with Apple — requires a paid Apple Developer account.
# Setup in https://developer.apple.com/account/:
#   1. Certificates, IDs & Profiles → Identifiers → create an App ID with the
#      "Sign in with Apple" capability.
#   2. Create a Services ID (this is APPLE_CLIENT_ID), enable Sign in with
#      Apple on it, and register the Return URL:
#        https://你的域名/api/auth/apple/callback
#      Apple only accepts HTTPS domains — no http, no localhost. For local
#      testing use an HTTPS tunnel (cloudflared / ngrok) and register the
#      tunnel URL as the Return URL, with APP_URL set to the tunnel origin.
#   3. Keys → create a "Sign in with Apple" key, download the .p8 file
#      (APPLE_KEY_ID is its Key ID; APPLE_TEAM_ID is in the top-right of the
#      developer portal).
# APPLE_CLIENT_ID=com.yourdomain.openbible.web
# Native iOS App ID / Bundle ID. This is separate from the web Services ID.
APPLE_IOS_CLIENT_ID=live.openbible.app
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=YYYYYYYYYY
# Prefer a mounted file in production; never place the .p8 in the repository
# or inside the mobile app bundle.
# APPLE_PRIVATE_KEY_PATH=/run/secrets/apple_sign_in_key
# Inline PEM remains supported for platforms that cannot mount a file:
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...p8 内容...\n-----END PRIVATE KEY-----"
# APP_URL=https://yourdomain.com

# ── 系统推送（信息提醒推送）──
# Android（FCM）：Firebase 控制台 → 项目设置 → 服务账号 → 生成私钥，JSON 放服务器后指路径
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
# iOS（APNs）：Apple 开发者后台 → Keys 创建 APNs Auth Key（.p8）
# APNS_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_BUNDLE_ID=live.openbible.app    # App 的 Bundle ID（缺省即此值）
# APNs 环境：Xcode 开发构建用 sandbox，TestFlight / App Store 用 production
# APNS_ENVIRONMENT=sandbox
# 推送大图标（可选，安卓通知右侧小图）
# PUSH_DEFAULT_IMAGE_URL=https://admin.openbible.live/openbible-notification-logo.png
# 设备注册时的 IP 归属地查询（可选，失败不影响推送注册）
# IP_GEOLOCATION_URL=https://ipwho.is

# ── 精读注释 RAG 检索服务（慧读回答引用注释）──
# 密钥只在服务端使用，绝不能打包进 App
OPENBIBLE_RAG_BASE_URL=http://127.0.0.1:8002
# OPENBIBLE_RAG_INTERNAL_API_KEY=replace-with-a-long-random-secret

# ── ESV 在线查经（可选）──
# 到 https://api.esv.org 免费申请，设置后 App 可在线查 ESV（不离线存储）
# ESV_API_KEY=
