# ===== ko-tts 生产环境变量 =====
# 用法: 复制为 deploy/.env.prod 并填入真实值。
#   cp deploy/.env.prod.example deploy/.env.prod
# .env.prod / .env 已被 .gitignore 忽略, 切勿提交。

# --- PostgreSQL (postgres 容器初始化用) ---
POSTGRES_USER=kotts
POSTGRES_PASSWORD=<填这里>
POSTGRES_DB=kotts

# --- 数据库连接 (后端 asyncpg 用) ---
# host 必须是 compose 服务名 postgres; 端口 5432; 账号密码库名要和上面一致
DATABASE_URL=postgresql+asyncpg://kotts:<填这里, 同 POSTGRES_PASSWORD>@postgres:5432/kotts

# --- Cloudflare R2 (S3 兼容) ---
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<填这里>
R2_SECRET_ACCESS_KEY=<填这里>
R2_BUCKET=ob-tts-data

# --- 安全 ---
# 生成: openssl rand -hex 32
JWT_SECRET=<填这里, 32+ 字符随机串>

# --- 应用 ---
ENVIRONMENT=prod
CORS_ORIGINS=https://kr-tts.openbible.live

# --- 可选 ---
LOG_LEVEL=info
TZ=Asia/Singapore

# --- 声音管理页 ElevenLabs 预设音色对比 (可选, 不填该对比选项报 503) ---
ELEVENLABS_API_KEY=

# --- 圣经注释 RAG ---
# Qdrant 只通过 compose 内网访问，不映射到公网。
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
RAG_INTERNAL_API_KEY=replace-with-a-long-random-secret

# 生产服务器 CPU Embedding；GPU 只保留 Reranker 与 Qwen。
INFINITY_EMBEDDING_URL=http://infinity:7997
# 7998 由生产服务器到 GPU 服务器的 SSH 隧道提供。
INFINITY_RERANKER_URL=http://host.docker.internal:7998
EMBEDDING_BATCH_SIZE=16
INDEX_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_DELAY_SECONDS=20
DOCUMENT_WORKER_POLL_SECONDS=3
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
